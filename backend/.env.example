# 필요한 키 목록만 공유한다. 실제 값은 backend/.env 에만 넣고 절대 커밋하지 않는다.
# AWS 자격증명은 여기 두지 않는다 — boto3 기본 체인(~/.aws 프로파일, SSO, IAM Role)을 사용.

# local | dev | staging | prod
# prod에서는 BEDROCK_KB_ID · BEDROCK_GUARDRAIL_ID · DART_API_KEY · JUTOPIA_DATA_DIR 중
# 하나라도 비어 있으면 서버가 기동하지 않는다.
APP_ENV=local

AWS_REGION=ap-northeast-2

# 서울 리전에서 Claude Sonnet/Haiku 4.5는 INFERENCE_PROFILE 전용 (ON_DEMAND 불가).
# apac. 프로파일은 없고 global. 프로파일만 제공됨 — 2026-09-13 AWS CLI 조회 기준, planning/sprint-0-log.md 참고
# 시스템 정의(크로스 리전) 프로파일은 RetrieveAndGenerate modelArn에 ID·ARN 둘 다 허용 (AWS 문서)
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0

# 비워두면 POST /api/v1/poc/ask 가 mock 응답. 채우면 실제 Bedrock 호출(요금 발생)
BEDROCK_KB_ID=
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# OpenDART 인증키 (https://opendart.fss.or.kr, 개인 키 하루 1만 회).
# 비워두면 GET /api/v1/stock/{code}/summary 가 개발용 mock 재무 데이터로 응답(Bedrock 호출 없음).
# 채우면 실제 DART 조회 + Bedrock 요약(요금 발생).
DART_API_KEY=
DART_CACHE_TTL_SECONDS=1800
# jutopia_data 저장소 경로 — DART 지표 계산 로직(dart_client.py)을 파일 단위로 읽는다. DART_API_KEY를 쓸 때 필수.
JUTOPIA_DATA_DIR=/Users/westhnu/Agent/Claude/jutopia_data

LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
