{
  "name": "haru-poc",
  "version": "0.1.0",
  "private": true,
  "description": "하루(Haru) — 개인 투자자용 Daily 2-Brief PoC (Next.js + 이중 LLM)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "build:krx": "node scripts/build-krx.mjs",
    "build:lambda": "esbuild --conditions=react-server scripts/lambda-handler.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/lambda-handler.mjs --external:@aws-sdk/* --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\" --loader:.json=json --tsconfig=tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "lucide-react": "^0.460.0",
    "next": "14.2.18",
    "openai": "^4.71.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.22.3",
    "typescript": "^5.6.3"
  }
}
