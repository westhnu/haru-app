# Haru frontend 환경변수 템플릿
# 원칙 3: 키 이름만 공유한다. 실제 값은 .env.local에 둔다 (git 추적 안 됨).
#   cp .env.example .env.local
# KI-019: 이 키들을 읽는 lib/*.ts는 import "server-only"로 client import가 막혀 있다.
#   단 next.config.mjs의 env 블록은 값을 서버 빌드 산출물에 넣으므로(베이크인 제거는 중장기 과제)
#   빌드 산출물 접근 권한 관리가 필요하다.

# LLM
OPENAI_API_KEY=
OPENAI_MODEL=
VERIFY_MODEL=

# 한국투자증권 KIS (조회 전용, 원칙 4)
KIS_APP_KEY_PROD=
KIS_APP_SECRET_PROD=
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ENV=

# DART (공시·재무)
DART_API_KEY=

# Tavily (이슈 검색)
TAVILY_API_KEY=

# TwelveData (해외 시세) — 변수명은 코드 표기 그대로 (TWELEVE_KEY)
TWELEVE_KEY=

# 저장소: STORAGE=s3이면 S3 사용, 비우면 로컬 파일 저장
STORAGE=
S3_BUCKET=
# AWS_REGION 운영값: ap-northeast-2
AWS_REGION=

# 생성 엔드포인트 보호 토큰 (운영 시 필수)
CRON_SECRET=
